DISCORD_TOKEN=
OPENROUTER_API_KEY=
ADMIN_IDS=123456789012345678            # permanent owners
GUILD_IDS=                               # your server ID(s): slash commands appear instantly
ADMIN_CHANNEL_ID=                        # alerts + daily report go here (else DMs to owners)

# Models (any OpenRouter model with tool calling)
FAST_MODEL=openai/gpt-4o-mini
SMART_MODEL=anthropic/claude-sonnet-4.5
FALLBACK_MODELS=
USER_DAILY_TOKENS=300000
USER_DAILY_USD=2.0

# auto = real systemd if present (your VPS), else simulated mock bots (Render)
BACKEND=auto
DB_PATH=nexus.db
WATCH_INTERVAL=60
REPORT_HOUR_UTC=9
MESSAGE_CONTENT=1
POWER_ON_WEBHOOK=
